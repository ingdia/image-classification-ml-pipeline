# Copy to .env and adjust. Never commit .env.

# Training hyper-parameters
EPOCHS=15
RETRAIN_EPOCHS=5
BATCH_SIZE=32
LEARNING_RATE=0.001

# Retrained model must reach (current accuracy - tolerance) on the test set to be promoted
PROMOTION_TOLERANCE=0.01

# Upload limits
MAX_UPLOAD_MB=20

# API server
PORT=8000
UVICORN_WORKERS=1

# Frontend: base URL of the API (empty = same origin, served behind nginx at /api)
VITE_API_URL=

# Host port for the nginx load balancer
HTTP_PORT=8080

# CPU cores per API container (load test compares 1/2/3 containers)
API_CPUS=2
