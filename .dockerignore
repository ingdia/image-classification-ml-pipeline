# Keep the build context small and never ship secrets
.git
.gitignore
**/__pycache__
**/*.pyc
.pytest_cache
.ipynb_checkpoints
.venv
venv
.env
kaggle.json
*.pem
*.key

# Data is mounted as a volume (locally) or downloaded at start (cloud), not baked into the image.
# Only the small demo samples and the precomputed dataset statistics are included.
data/*
!data/samples
!data/dataset_stats.json
runtime/
models/candidates/

# Frontend has its own image
frontend/

# Load testing runs in the locust image
locust/
